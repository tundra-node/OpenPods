<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        android:title="@string/settings_appearance"
        app:iconSpaceReserved="true">

        <ListPreference
            android:defaultValue="system"
            android:entries="@array/theme_entries"
            android:entryValues="@array/theme_values"
            android:icon="@drawable/ic_dark_mode"
            android:key="theme"
            android:summary="%s"
            android:title="@string/theme_title"
            app:iconSpaceReserved="true"
            app:singleLineTitle="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/settings_notifications"
        app:iconSpaceReserved="true">

        <SwitchPreference
            android:defaultValue="true"
            android:icon="@drawable/ic_notifications"
            android:key="showConnectCard"
            android:summary="@string/showConnectCard_desc"
            android:title="@string/showConnectCard"
            app:iconSpaceReserved="true"
            app:singleLineTitle="false" />

        <SwitchPreference
            android:defaultValue="true"
            android:icon="@drawable/ic_battery_full"
            android:key="lowBatteryAlerts"
            android:summary="@string/lowBatteryAlerts_desc"
            android:title="@string/lowBatteryAlerts"
            app:iconSpaceReserved="true"
            app:singleLineTitle="false" />

        <SwitchPreference
            android:defaultValue="false"
            android:icon="@drawable/ic_graphic_eq"
            android:key="connectSound"
            android:summary="@string/connectSound_desc"
            android:title="@string/connectSound"
            app:iconSpaceReserved="true"
            app:singleLineTitle="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/settings_behavior"
        app:iconSpaceReserved="true">

        <SwitchPreference
            android:defaultValue="false"
            android:icon="@drawable/ic_bolt"
            android:key="batterySaver"
            android:summary="@string/batterySaver_desc"
            android:title="@string/batterySaver"
            app:iconSpaceReserved="true"
            app:singleLineTitle="false" />

        <SwitchPreference
            android:defaultValue="true"
            android:icon="@drawable/ic_inear_24dp"
            android:key="pauseOnRemoval"
            android:summary="@string/pauseOnRemoval_desc"
            android:title="@string/pauseOnRemoval"
            app:iconSpaceReserved="true"
            app:singleLineTitle="false" />

        <SwitchPreference
            android:defaultValue="false"
            android:icon="@drawable/ic_refresh"
            android:key="resumeOnInsertion"
            android:summary="@string/resumeOnInsertion_desc"
            android:title="@string/resumeOnInsertion"
            app:iconSpaceReserved="true"
            app:singleLineTitle="false" />

        <SwitchPreference
            android:defaultValue="true"
            android:icon="@drawable/ic_close"
            android:key="enforcePause"
            android:summary="@string/enforcePause_desc"
            android:title="@string/enforcePause"
            app:iconSpaceReserved="true"
            app:singleLineTitle="false" />

        <Preference
            android:icon="@drawable/ic_refresh"
            android:key="restartService"
            android:summary="@string/restart_desc"
            android:title="@string/restart"
            app:iconSpaceReserved="true"
            app:singleLineTitle="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/settings_noise"
        app:iconSpaceReserved="true">

        <SwitchPreference
            android:defaultValue="false"
            android:icon="@drawable/ic_graphic_eq"
            android:key="conversationAwareness"
            android:summary="@string/conversationAwareness_desc"
            android:title="@string/conversationAwareness"
            app:iconSpaceReserved="true"
            app:singleLineTitle="false" />

        <SeekBarPreference
            android:defaultValue="50"
            android:icon="@drawable/ic_graphic_eq"
            android:key="adaptiveStrength"
            android:max="100"
            android:summary="@string/adaptiveStrength_desc"
            android:title="@string/adaptiveStrength"
            app:iconSpaceReserved="true"
            app:showSeekBarValue="true"
            app:singleLineTitle="false" />

        <Preference
            android:icon="@drawable/ic_settings"
            android:key="rename"
            android:summary="@string/rename_desc"
            android:title="@string/rename"
            app:iconSpaceReserved="true"
            app:singleLineTitle="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/about"
        app:iconSpaceReserved="true">

        <Preference
            android:icon="@drawable/ic_info"
            android:key="about"
            android:summary="@string/app_name"
            android:title="@string/about"
            app:iconSpaceReserved="true"
            app:singleLineTitle="false">
            <intent
                android:targetClass="com.dosse.airpods.ui.AboutActivity"
                android:targetPackage="com.dosse.airpods" />
        </Preference>

        <Preference
            android:key="fork"
            android:summary="@string/fork_repo_url"
            android:title="@string/fork_repo"
            app:iconSpaceReserved="true"
            app:singleLineTitle="false">
            <intent
                android:action="android.intent.action.VIEW"
                android:data="@string/fork_repo_url" />
        </Preference>

        <Preference
            android:key="fdroid"
            android:title="@string/fdroid"
            app:iconSpaceReserved="true"
            app:singleLineTitle="false">
            <intent
                android:action="android.intent.action.VIEW"
                android:data="@string/fdroid_url" />
        </Preference>

        <Preference
            android:key="website"
            android:title="@string/website"
            app:iconSpaceReserved="true"
            app:singleLineTitle="false">
            <intent
                android:action="android.intent.action.VIEW"
                android:data="@string/website_url" />
        </Preference>

        <Preference
            android:key="github"
            android:title="@string/github"
            app:iconSpaceReserved="true"
            app:singleLineTitle="false">
            <intent
                android:action="android.intent.action.VIEW"
                android:data="@string/github_url" />
        </Preference>

        <Preference
            android:icon="@drawable/ic_favorite"
            android:key="donate"
            android:title="@string/donate"
            app:iconSpaceReserved="true"
            app:singleLineTitle="false">
            <intent
                android:action="android.intent.action.VIEW"
                android:data="@string/donate_url" />
        </Preference>

    </PreferenceCategory>

</PreferenceScreen>
