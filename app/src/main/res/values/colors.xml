    <!-- Colors used by the notification RemoteViews.
         On API < 29 the notification must draw its own background, so it
         follows the theme chosen in the app (see NotificationBuilder).
         On API >= 29 values-v29 makes the background transparent so the
         system styles the notification instead. -->
    <color name="textColorPrimary" >@color/md_on_surface</color>
    <color name="bgColorPrimary"   >#FFFFFF</color>
    <color name="imageTintPrimary" >#1A1B21</color>

    <color name="dgrey"            >#737373</color>
