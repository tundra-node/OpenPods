<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="ContentDescription">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/md_surface"
        app:liftOnScroll="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/md_surface"
            app:title="@string/app_name"
            app:titleTextAppearance="?attr/textAppearanceTitleLarge" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="@dimen/space_xl"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/padding_main"
            android:paddingTop="@dimen/space_s"
            android:paddingEnd="@dimen/padding_main">

            <!-- ===================== Live status ===================== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/heroCard"
                style="@style/Widget.OpenPods.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <TextView
                        android:id="@+id/statusPill"
                        style="@style/Widget.OpenPods.Pill"
                        android:background="@drawable/bg_pill_disconnected"
                        android:drawableStart="@drawable/ic_bluetooth_disabled"
                        android:drawableTint="@color/md_on_neutral_container"
                        android:text="@string/notConnected"
                        android:textColor="@color/md_on_neutral_container" />

                    <TextView
                        android:id="@+id/statusTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_l"
                        android:textAppearance="?attr/textAppearanceHeadlineMedium"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:text="AirPods Pro 2"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/statusSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:visibility="gone"
                        tools:text="Updated just now"
                        tools:visibility="visible" />

                    <!-- Battery tiles -->
                    <LinearLayout
                        android:id="@+id/podsRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_l"
                        android:baselineAligned="false"
                        android:gravity="top"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <LinearLayout
                            android:id="@+id/leftPod"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <ImageView
                                android:id="@+id/podLeftImg"
                                android:layout_width="@dimen/pod_tile_img"
                                android:layout_height="@dimen/pod_tile_img"
                                android:src="@drawable/pod" />

                            <TextView
                                android:id="@+id/podLeftText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_s"
                                android:textAppearance="?attr/textAppearanceTitleMedium"
                                android:textStyle="bold"
                                tools:text="87%" />

                            <com.google.android.material.progressindicator.LinearProgressIndicator
                                android:id="@+id/podLeftBar"
                                android:layout_width="@dimen/pod_bar_width"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_s"
                                app:indicatorColor="@color/md_primary"
                                app:trackColor="@color/md_surface_container_highest"
                                app:trackCornerRadius="3dp"
                                app:trackThickness="@dimen/pod_bar_height" />

                            <TextView
                                android:id="@+id/podLeftInEar"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_s"
                                android:drawableStart="@drawable/ic_inear_16dp"
                                android:drawablePadding="4dp"
                                android:drawableTint="@color/md_primary"
                                android:gravity="center_vertical"
                                android:text="@string/in_ear"
                                android:textAppearance="?attr/textAppearanceLabelSmall"
                                android:textColor="@color/md_primary" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/rightPod"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <ImageView
                                android:id="@+id/podRightImg"
                                android:layout_width="@dimen/pod_tile_img"
                                android:layout_height="@dimen/pod_tile_img"
                                android:src="@drawable/pod" />

                            <TextView
                                android:id="@+id/podRightText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_s"
                                android:textAppearance="?attr/textAppearanceTitleMedium"
                                android:textStyle="bold"
                                tools:text="87%" />

                            <com.google.android.material.progressindicator.LinearProgressIndicator
                                android:id="@+id/podRightBar"
                                android:layout_width="@dimen/pod_bar_width"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_s"
                                app:indicatorColor="@color/md_primary"
                                app:trackColor="@color/md_surface_container_highest"
                                app:trackCornerRadius="3dp"
                                app:trackThickness="@dimen/pod_bar_height" />

                            <TextView
                                android:id="@+id/podRightInEar"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_s"
                                android:drawableStart="@drawable/ic_inear_16dp"
                                android:drawablePadding="4dp"
                                android:drawableTint="@color/md_primary"
                                android:gravity="center_vertical"
                                android:text="@string/in_ear"
                                android:textAppearance="?attr/textAppearanceLabelSmall"
                                android:textColor="@color/md_primary" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/casePod"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <ImageView
                                android:id="@+id/podCaseImg"
                                android:layout_width="@dimen/pod_tile_img"
                                android:layout_height="@dimen/pod_tile_img"
                                android:src="@drawable/pod_case" />

                            <TextView
                                android:id="@+id/podCaseText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_s"
                                android:textAppearance="?attr/textAppearanceTitleMedium"
                                android:textStyle="bold"
                                tools:text="100%" />

                            <com.google.android.material.progressindicator.LinearProgressIndicator
                                android:id="@+id/podCaseBar"
                                android:layout_width="@dimen/pod_bar_width"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_s"
                                app:indicatorColor="@color/md_primary"
                                app:trackColor="@color/md_surface_container_highest"
                                app:trackCornerRadius="3dp"
                                app:trackThickness="@dimen/pod_bar_height" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Shown when nothing is connected -->
                    <LinearLayout
                        android:id="@+id/emptyState"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingTop="@dimen/space_m"
                        android:paddingBottom="@dimen/space_m">

                        <FrameLayout
                            android:layout_width="88dp"
                            android:layout_height="88dp"
                            android:background="@drawable/bg_circle_tonal">

                            <ImageView
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_bluetooth_disabled"
                                android:tint="?attr/colorOnSurfaceVariant" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_l"
                            android:gravity="center"
                            android:text="@string/empty_title"
                            android:textAppearance="?attr/textAppearanceTitleMedium" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:gravity="center"
                            android:text="@string/empty_msg"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===================== Noise control ===================== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/noiseCard"
                style="@style/Widget.OpenPods.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_graphic_eq"
                            android:tint="?attr/colorPrimary" />

                        <TextView
                            android:id="@+id/noiseTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_m"
                            android:layout_weight="1"
                            android:text="@string/settings_noise"
                            android:textAppearance="?attr/textAppearanceTitleMedium" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/noiseGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_m"
                        android:orientation="vertical"
                        android:visibility="gone"
                        app:selectionRequired="true"
                        app:singleSelection="true"
                        tools:visibility="visible">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/noiseOff"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="start|center_vertical"
                            android:minHeight="48dp"
                            android:text="@string/noise_off"
                            android:textAppearance="?attr/textAppearanceBodyLarge" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/noiseAnc"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="start|center_vertical"
                            android:minHeight="48dp"
                            android:text="@string/noise_anc"
                            android:textAppearance="?attr/textAppearanceBodyLarge" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/noiseTransparency"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="start|center_vertical"
                            android:minHeight="48dp"
                            android:text="@string/noise_transparency"
                            android:textAppearance="?attr/textAppearanceBodyLarge" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/noiseAdaptive"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="start|center_vertical"
                            android:minHeight="48dp"
                            android:text="@string/noise_adaptive"
                            android:textAppearance="?attr/textAppearanceBodyLarge" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>

                    <TextView
                        android:id="@+id/noiseUnavailable"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_m"
                        android:text="@string/noise_unavailable"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===================== Supported devices ===================== -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.OpenPods.Card.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:text="@string/supportedDevicesTitle" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s"
                        android:lineSpacingExtra="4dp"
                        android:text="@string/supportedDevicesList"
                        android:textAppearance="?attr/textAppearanceBodyMedium" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_m"
                        android:text="@string/main_description"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:gravity="center"
                android:text="@string/fork_footer"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="?attr/colorOutline" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
